# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Dependencies
COPY go.mod go.sum ./
RUN go mod download

# Source code
COPY . .

# Build the Go app (CGO_ENABLED=0 since modernc/sqlite is pure Go)
RUN CGO_ENABLED=0 GOOS=linux go build -o neo-backend main.go

# Final stage
FROM alpine:3.19

WORKDIR /app

# Add ca-certificates for external API calls
RUN apk --no-cache add ca-certificates

# Copy binary from builder
COPY --from=builder /app/neo-backend .

# Setup non-root user
RUN adduser -D neo
USER neo

# Expose default port
EXPOSE 9090

# Command to run
ENTRYPOINT ["./neo-backend"]
